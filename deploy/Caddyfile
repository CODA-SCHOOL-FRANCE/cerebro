# Reverse proxy TLS pour Cerebro.Server, pensé pour un réseau d'examen isolé (pas de CA publique
# accessible : Caddy génère et sert un certificat auto-signé via sa CA interne locale).
#
# Trois façons de déployer, ce fichier sert dans les trois cas (seul CEREBRO_UPSTREAM change) :
#
#   A. Binaire publié directement, Caddy natif sur la même machine :
#        ASPNETCORE_URLS=http://127.0.0.1:5289 dotnet Cerebro.Server.dll
#        CEREBRO_SERVER_ADDRESS=192.168.1.10 caddy run --config Caddyfile
#
#   B. Conteneur Docker seul (voir src/Cerebro.Server/Dockerfile), Caddy natif sur l'hôte :
#        docker run -d -p 127.0.0.1:8080:8080 \
#          -v cerebro-db:/app/db -v cerebro-screenshots:/app/screenshots \
#          --name cerebro-server ghcr.io/<owner>/cerebro-server:<version>
#        CEREBRO_SERVER_ADDRESS=192.168.1.10 CEREBRO_UPSTREAM=localhost:8080 caddy run --config Caddyfile
#
#   C. Tout conteneurisé via deploy/docker-compose.yml (recommandé — voir README, section Docker) :
#        CEREBRO_SERVER_ADDRESS=192.168.1.10 docker compose -f deploy/docker-compose.yml up -d --build
#        (CEREBRO_UPSTREAM y est déjà réglé sur cerebro-server:8080, résolu par le DNS interne
#        de Docker — rien à faire de plus)
#
# Dans tous les cas, récupérer ensuite l'empreinte du certificat à communiquer aux agents étudiants :
#   openssl s_client -connect 192.168.1.10:8443 </dev/null 2>/dev/null \
#     | openssl x509 -noout -fingerprint -sha256
#
# Les étudiants se connectent alors sur https://192.168.1.10:8443 (le certificat sera signalé
# comme non approuvé par leur navigateur/OS — c'est attendu pour un certificat auto-signé ;
# l'agent, lui, valide le certificat par épingle d'empreinte plutôt que par la chaîne de confiance
# du système, voir CEREBRO_SERVER_CERT_THUMBPRINT dans le README).

# Un navigateur/curl connecté directement sur une IP littérale (pas un nom d'hôte) n'envoie
# généralement aucun SNI dans le ClientHello TLS (RFC 6066) : sans "default_sni", Caddy ne sait
# alors pas quel certificat servir (un seul site est pourtant configuré) et répond par une alerte
# TLS "internal_error" avant même l'envoi du certificat. CEREBRO_SERVER_ADDRESS étant justement une
# IP dans ce déploiement (le poste serveur sur le réseau d'examen), on force explicitement le
# certificat à utiliser quand aucun SNI n'est présenté.
#
# CA interne personnalisée : Caddy ne permet pas de définir un champ Organization sur le
# certificat serveur lui-même (seul le CommonName de la CA racine/intermédiaire est
# configurable, voir https://caddyserver.com/docs/caddyfile/options#pki-app) - "CODA" apparaît
# donc dans le champ Issuer du certificat (visible en l'inspectant), pas dans un champ O=.
#
# intermediate_lifetime est indispensable ici : un certificat signé ne peut jamais dépasser la
# validité de son émetteur, et l'intermédiaire par défaut de Caddy n'est valide que 7 jours - sans
# l'étendre, le "lifetime 43800h" (5 ans) demandé plus bas serait silencieusement ramené à
# quelques jours (vérifié : log "cert lifetime would exceed issuer NotAfter, clamping lifetime").
# Doit rester strictement inférieur à la durée de vie de la CA racine (~86400h/~9,8 ans, non
# configurable) - Caddy refuse sinon de démarrer (vérifié).
{
	pki {
		ca local {
			name "CODA Cerebro CA"
			root_cn "CODA Cerebro Root CA"
			intermediate_cn "CODA Cerebro Intermediate CA"
			intermediate_lifetime 70080h
		}
	}

	default_sni {$CEREBRO_SERVER_ADDRESS:localhost}
}

{$CEREBRO_SERVER_ADDRESS:localhost}:8443 {
	# Durée de vie du certificat serveur : 5 ans (43800h) au lieu des 12h par défaut. Le certificat
	# est de toute façon persisté dans le volume caddy_data (voir docker-compose.yml) et son
	# empreinte SHA-256 épinglée côté agents (CEREBRO_SERVER_CERT_THUMBPRINT) - un renouvellement
	# automatique fréquent (défaut 12h) est une source de risque inutile de changement silencieux
	# de cette empreinte entre deux sessions d'examen.
	tls {
		issuer internal {
			lifetime 43800h
		}
	}

	reverse_proxy {$CEREBRO_UPSTREAM:localhost:5289}
}
