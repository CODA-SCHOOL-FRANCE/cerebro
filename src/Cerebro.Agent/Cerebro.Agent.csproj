<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Cerebro.Shared\Cerebro.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.10" />
    <!-- Redimensionnement + encodage WebP des screenshots avant envoi (voir ScreenshotCompressor).
         Variante NoDependencies pour Linux : évite d'exiger fontconfig sur la machine candidate
         (inutile ici, on ne fait ni rendu de texte ni de police). -->
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
    <PackageReference Include="ConsoleAppFramework" Version="5.7.13" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Nom de l'exécutable publié aux candidats (voir docs/USER-DOC.txt, docs/ARCHITECTURE.md) :
         distinct du nom du projet/namespace (Cerebro.Agent), qui reste inchangé côté code source. -->
    <AssemblyName>xavier</AssemblyName>
    <!-- Sans ce flag, "dotnet publish ... -p:PublishSingleFile=true" laisse libSkiaSharp.{dylib,so,dll}
         (ScreenshotCompressor) comme fichier séparé à côté de l'exécutable au lieu de l'embarquer dans
         le fichier unique. Les canaux d'installation qui n'extraient que le binaire (npm, Homebrew,
         install.sh/.ps1) perdaient alors silencieusement la compression WebP - ScreenshotCompressor.Compress
         retombe sur le PNG non compressé faute de bibliothèque native trouvable (repro : ~9,2 Mo par
         screenshot au lieu de ~170 Ko). N'a d'effet qu'en self-contained + single-file (voir
         .github/workflows/release.yml) ; ignoré par "dotnet run"/"dotnet build" en développement. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

</Project>
